# ─────────────────────────────────────────────
# HumbleHalal — Environment Variables
# Copy this file to .env.local and fill in values
# All variables must be prefixed with VITE_ to be
# exposed to the browser bundle.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
VITE_APP_URL=https://humblehalal.sg

# ── Supabase (auth + database) ───────────────
# https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Google Maps (BusinessDetail map + submit location) ──
# https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Prayer Times API ──────────────────────────
# Suggested: Aladhan API (free) https://aladhan.com/prayer-times-api
# or MUIS Singapore official feed
VITE_PRAYER_TIMES_API_URL=https://api.aladhan.com/v1
# For MUIS direct:
# VITE_MUIS_PRAYER_API_KEY=your-muis-api-key

# ── Halal Certification API ───────────────────
# MUIS Singapore halal certification lookup
# Contact MUIS for API access: https://www.muis.gov.sg
VITE_HALAL_CERT_API_URL=https://api.muis.gov.sg/halal
VITE_HALAL_CERT_API_KEY=your-muis-api-key

# ── Email / Contact Form ──────────────────────
# Suggested: Resend (https://resend.com) or EmailJS
# Note: Use a server-side function/edge function — do NOT expose secret keys here
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# ── Analytics ────────────────────────────────
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Or Plausible Analytics:
# VITE_PLAUSIBLE_DOMAIN=humblehalal.sg

# ── Error Monitoring ─────────────────────────
# Sentry DSN — update ErrorBoundary.tsx to use Sentry.captureException()
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
